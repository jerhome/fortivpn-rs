<?xml version="1.0" encoding="utf-8"?>
<!--
  Vecteur fortivpn-rs (docs/protocol.md §3.4) : réponse à GET /remote/fortisslvpn_xml?dual_stack=1
  (format openconnect). Hors MVP : documente la section <ipv6> pour ne pas la rejeter au parsing.
  Préfixes IPv6 de documentation (2001:db8::/32) et ULA. Valeurs fictives.
-->
<sslvpn-tunnel ver="2" dtls="1" patch="1">
  <tunnel-method value="ppp"/>
  <auth-ses check-src-ip='1' tun-connect-without-reauth='1' tun-user-ses-timeout='240' />
  <ipv4>
    <dns ip="10.0.0.53" domain="corp.example.com"/>
    <assigned-addr ipv4="10.10.0.2"/>
    <split-tunnel-info>
      <addr ip="10.0.0.0" mask="255.0.0.0"/>
    </split-tunnel-info>
  </ipv4>
  <ipv6>
    <dns ipv6="fd00:10::53"/>
    <assigned-addr ipv6='fd00:10:0:1::2' prefix-len='64'/>
    <split-tunnel-info>
      <addr ipv6='fd00:10::' prefix-len='48'/>
    </split-tunnel-info>
    <split-tunnel-info negate="1">
      <addr ipv6='2001:db8:dead::' prefix-len='48'/>
    </split-tunnel-info>
  </ipv6>
  <idle-timeout val="3600"/>
  <auth-timeout val="28800"/>
</sslvpn-tunnel>
