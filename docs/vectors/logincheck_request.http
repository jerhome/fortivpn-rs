# POST /remote/logincheck — authentification login/mot de passe (format openfortivpn, http.c).
# Identifiants FICTIFS : username 'jdoe', mot de passe 'S3cr3t!&= é' (UTF-8), realm 'staff'.
# Encodage : tout octet hors [A-Za-z0-9-_.~] -> %XX en MAJUSCULES, espace -> %20 (pas '+'),
# UTF-8 octet par octet ('é' = c3 a9 -> %C3%A9).
# Ordre des champs openfortivpn : username, credential, realm, ajax=1 (realm présent même vide :
# 'realm=&ajax=1'). L'en-tête 'Cookie:' est envoyé VIDE par openfortivpn avant authentification ;
# un client peut l'omettre. Corps sans saut de ligne final.
#
# --- message (lignes d'en-tête : LF dans le fichier, CRLF sur le fil) ---
POST /remote/logincheck HTTP/1.1
Host: vpn.example.com:443
User-Agent: Mozilla/5.0 SV1
Accept: */*
Accept-Encoding: identity
Pragma: no-cache
Cache-Control: no-store, no-cache, must-revalidate
If-Modified-Since: Sat, 1 Jan 2000 00:00:00 GMT
Content-Type: application/x-www-form-urlencoded
Cookie: 
Content-Length: 68

username=jdoe&credential=S3cr3t%21%26%3D%20%C3%A9&realm=staff&ajax=1
